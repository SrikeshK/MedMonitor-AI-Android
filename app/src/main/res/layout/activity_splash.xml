<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient">

    <!-- Radial Glow behind logo -->
    <View
        android:id="@+id/vRadialGlow"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/radial_glow"
        app:layout_constraintBottom_toBottomOf="@id/ivSplashLogo"
        app:layout_constraintEnd_toEndOf="@id/ivSplashLogo"
        app:layout_constraintStart_toStartOf="@id/ivSplashLogo"
        app:layout_constraintTop_toTopOf="@id/ivSplashLogo" />

    <!-- Glass Effect Background -->
    <View
        android:id="@+id/vGlassEffect"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/glass_background"
        app:layout_constraintBottom_toBottomOf="@id/ivSplashLogo"
        app:layout_constraintEnd_toEndOf="@id/ivSplashLogo"
        app:layout_constraintStart_toStartOf="@id/ivSplashLogo"
        app:layout_constraintTop_toTopOf="@id/ivSplashLogo" />

    <ImageView
        android:id="@+id/ivSplashLogo"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:contentDescription="App Logo"
        android:src="@drawable/medmonitor_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45" />

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:letterSpacing="0.05"
        android:text="MedMonitor"
        android:textColor="@color/white"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vGlassEffect" />

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0"
        android:text="Smart Medication. Safer Lives."
        android:textColor="#B3FFFFFF"
        android:textSize="16sp"
        android:letterSpacing="0.02"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAppName" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/loadingBar"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:indeterminate="true"
        app:indicatorColor="@color/cyan_glow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:trackColor="#1AFFFFFF"
        app:trackCornerRadius="8dp"
        app:trackThickness="6dp" />

</androidx.constraintlayout.widget.ConstraintLayout>