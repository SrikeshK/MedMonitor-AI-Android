<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="Add New Medicine"
            app:titleCentered="true"
            app:titleTextColor="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:animateLayoutChanges="true">

            <!-- STEP 7: IMAGE UPLOAD / SCAN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/layoutScanAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/dash_border"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="@color/glass_cyan" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Scan Medicine Label"
                        android:textColor="@color/glass_cyan"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanMedicine"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Take Photo"
                        android:textColor="@color/white"
                        app:rippleColor="#3300E5FF" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/cameraContainer"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:visibility="gone">

                    <androidx.camera.view.PreviewView
                        android:id="@+id/viewFinder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToOutline="true" />

                    <ImageView
                        android:id="@+id/ivMedicinePreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCapture"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="16dp"
                        app:icon="@android:drawable/ic_menu_camera"
                        app:iconSize="32dp"
                        app:iconTint="@color/white"
                        app:backgroundTint="@color/glass_cyan" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/layoutConfirmImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetake"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Retake"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/glass_cyan" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmImage"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Confirm"
                    app:backgroundTint="@color/success"
                    app:cornerRadius="16dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutAiStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvAiStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Verified ✅"
                    android:textColor="@color/success"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- MEDICINE INFO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_card_bg"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Section Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="6dp"
                            android:src="@android:drawable/ic_menu_edit"
                            android:background="@drawable/circular_icon_bg"
                            app:tint="@color/glass_cyan" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Medicine Details"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMedicineName"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/glass_input_selector"
                            android:hint="Medicine Name"
                            android:paddingHorizontal="20dp"
                            android:textColor="@color/white"
                            android:textColorHint="@color/text_secondary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- STEP 2: MEDICINE TYPE SELECTION CARDS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnTablet"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="💊 Tablet"
                            android:background="@drawable/bg_unselected"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:padding="12dp"/>

                        <TextView
                            android:id="@+id/btnSyrup"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🧴 Syrup"
                            android:background="@drawable/bg_unselected"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:padding="12dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutDoseAmount"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp"
                            app:hintEnabled="false"
                            app:suffixTextColor="@color/glass_cyan">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDoseAmount"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:background="@drawable/glass_input_selector"
                                android:hint="Dose"
                                android:inputType="numberDecimal"
                                android:paddingHorizontal="20dp"
                                android:textColor="@color/white"
                                android:textColorHint="@color/text_secondary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutTotalQuantity"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTotalQuantity"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:background="@drawable/glass_input_selector"
                                android:hint="Total Pack"
                                android:inputType="numberDecimal"
                                android:paddingHorizontal="20dp"
                                android:textColor="@color/white"
                                android:textColorHint="@color/text_secondary" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Threshold Mode Toggle -->
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleThresholdMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:checkedButton="@+id/btnAutoThreshold"
                        app:selectionRequired="true"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAutoThreshold"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Auto"
                            app:cornerRadius="12dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManualThreshold"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Manual"
                            app:cornerRadius="12dp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- STEP 5: Low Stock Threshold (Per Medicine) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutLowStockThreshold"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLowStockThreshold"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/glass_input_selector"
                            android:hint="Low Stock Threshold"
                            android:inputType="number"
                            android:paddingHorizontal="20dp"
                            android:textColor="@color/white"
                            android:textColorHint="@color/text_secondary" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DATE SECTION -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/btnSelectDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_card_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_menu_today"
                        android:background="@drawable/circular_icon_bg"
                        app:tint="@color/glass_cyan" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Duration"
                            android:textColor="@color/white"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvSelectedRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select Date Range"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_more"
                        app:tint="@color/text_secondary"
                        android:rotation="90"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- STEP 4: FOOD TIMING (VERTICAL CARDS) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_card_bg"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="6dp"
                            android:src="@android:drawable/ic_menu_compass"
                            android:background="@drawable/circular_icon_bg"
                            app:tint="@color/glass_cyan" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Food Timing"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/beforeFood"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🍽 Before Food"
                            android:padding="12dp"
                            android:layout_marginBottom="8dp"
                            android:textColor="@color/white"
                            android:background="@drawable/bg_unselected"/>

                        <TextView
                            android:id="@+id/afterFood"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🍽 After Food"
                            android:padding="12dp"
                            android:layout_marginBottom="8dp"
                            android:textColor="@color/white"
                            android:background="@drawable/bg_unselected"/>

                        <TextView
                            android:id="@+id/anytime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🌙 Anytime"
                            android:padding="12dp"
                            android:textColor="@color/white"
                            android:background="@drawable/bg_unselected"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SCHEDULE CARDS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_card_bg"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="6dp"
                            android:src="@android:drawable/ic_menu_recent_history"
                            android:background="@drawable/circular_icon_bg"
                            app:tint="@color/glass_cyan" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Daily Schedule"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Morning Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="@drawable/glass_input_background"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp">
                        <CheckBox
                            android:id="@+id/cbMorning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/glass_cyan" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Morning"
                            android:textColor="@color/white"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvMorningTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/circular_icon_bg"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="08:00 AM"
                            android:textColor="@color/glass_cyan"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Afternoon Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="@drawable/glass_input_background"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp">
                        <CheckBox
                            android:id="@+id/cbAfternoon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/glass_cyan" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Afternoon"
                            android:textColor="@color/white"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvAfternoonTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/circular_icon_bg"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="01:00 PM"
                            android:textColor="@color/glass_cyan"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Night Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="@drawable/glass_input_background"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp">
                        <CheckBox
                            android:id="@+id/cbNight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/glass_cyan" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Night"
                            android:textColor="@color/white"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvNightTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/circular_icon_bg"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="09:00 PM"
                            android:textColor="@color/glass_cyan"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SAVE BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveMedicine"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="SAVE MEDICINE"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:stateListAnimator="@animator/press_scale"
                app:backgroundTint="@color/glass_cyan"
                app:cornerRadius="20dp"
                app:rippleColor="#4DFFFFFF" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
