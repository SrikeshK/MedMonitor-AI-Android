<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment_caregiver"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav_wrapper"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/nav_graph_caregiver" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_nav_wrapper"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/bottom_navigation_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_nav_final"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="4">

            <!-- Dashboard -->
            <LinearLayout
                android:id="@+id/navigation_caregiver_dashboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">
                <LinearLayout
                    android:id="@+id/navContent_dashboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">
                    <ImageView
                        android:id="@+id/icon_dashboard"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginBottom="2dp"
                        android:src="@drawable/ic_chart"
                        app:tint="#80FFFFFF"/>
                    <TextView
                        android:id="@+id/text_dashboard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dashboard"
                        android:textSize="9sp"
                        android:textColor="#80FFFFFF"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.02"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Patients -->
            <LinearLayout
                android:id="@+id/navigation_patients"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">
                <LinearLayout
                    android:id="@+id/navContent_patients"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">
                    <ImageView
                        android:id="@+id/icon_patients"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginBottom="2dp"
                        android:src="@drawable/ic_person"
                        app:tint="#80FFFFFF"/>
                    <TextView
                        android:id="@+id/text_patients"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Patients"
                        android:textSize="9sp"
                        android:textColor="#80FFFFFF"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.02"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Alerts -->
            <LinearLayout
                android:id="@+id/navigation_alerts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">
                <LinearLayout
                    android:id="@+id/navContent_alerts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">
                    <ImageView
                        android:id="@+id/icon_alerts"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginBottom="2dp"
                        android:src="@drawable/ic_notification"
                        app:tint="#80FFFFFF"/>
                    <TextView
                        android:id="@+id/text_alerts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alerts"
                        android:textSize="9sp"
                        android:textColor="#80FFFFFF"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.02"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Profile -->
            <LinearLayout
                android:id="@+id/navigation_profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">
                <LinearLayout
                    android:id="@+id/navContent_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">
                    <ImageView
                        android:id="@+id/icon_profile"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginBottom="2dp"
                        android:src="@drawable/ic_person"
                        app:tint="#80FFFFFF"/>
                    <TextView
                        android:id="@+id/text_profile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Profile"
                        android:textSize="9sp"
                        android:textColor="#80FFFFFF"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.02"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>