<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#111827"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="#1AFFFFFF"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Avatar with Ring -->
        <FrameLayout
            android:id="@+id/avatarContainer"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/statusRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/circle_ring" />

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/glass_circle_bg"
                android:gravity="center"
                android:text="P"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Center Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/statusChip"
            app:layout_constraintStart_toEndOf="@id/avatarContainer"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvPatientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patient Name"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMedDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Medicine • 08:00 AM"
                android:textColor="#9AA4B2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvRelativeTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2 hours ago"
                android:textColor="#4DFFFFFF"
                android:textSize="11sp" />

            <!-- Action Buttons (Icon Only) -->
            <LinearLayout
                android:id="@+id/actionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTaken"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:padding="0dp"
                    android:visibility="gone"
                    app:backgroundTint="#1A00E676"
                    app:icon="@drawable/ic_check"
                    app:iconSize="20dp"
                    app:iconTint="#00E676"
                    app:iconPadding="0dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="24dp"
                    android:contentDescription="Mark medicine as taken" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMessage"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:padding="0dp"
                    app:backgroundTint="#1A00E5FF"
                    app:icon="@drawable/ic_email"
                    app:iconSize="20dp"
                    app:iconTint="#00E5FF"
                    app:iconPadding="0dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="24dp"
                    android:contentDescription="Send message" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCall"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:padding="0dp"
                    app:backgroundTint="#1A4CAF50"
                    app:icon="@drawable/ic_phone"
                    app:iconSize="20dp"
                    app:iconTint="#4CAF50"
                    app:iconPadding="0dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="24dp"
                    android:contentDescription="Call patient" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Badge -->
        <TextView
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_badge_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="MISSED"
            android:textColor="#FF5252"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>