<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAction"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="8dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="1.2dp"
    app:strokeColor="#2A3A5F">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:background="@drawable/bg_glass_card"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- LEFT ICON - Refined Glass Style -->
        <ImageView
            android:id="@+id/medicineIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_pill"
            android:background="@drawable/glass_circle_bg"
            android:padding="11dp"
            app:tint="#00E5FF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- RIGHT BUTTON - Action Chip Style -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="32dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="0dp"
            android:text="Confirm"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:backgroundTint="@null"
            android:background="@drawable/bg_gradient_button"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- CENTER CONTENT - Improved Alignment & Spacing -->
        <LinearLayout
            android:id="@+id/contentLayout"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/medicineIcon"
            app:layout_constraintEnd_toStartOf="@id/confirmBtn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:gravity="center"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp">

            <TextView
                android:id="@+id/medicineName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paracetamol"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                android:gravity="center"/>

            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="12:37 PM"
                android:textColor="#FF8A80"
                android:textSize="12sp"
                android:alpha="0.9"
                android:gravity="center"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Missed Dose"
                android:textColor="#FF8A80"
                android:textSize="11sp"
                android:textStyle="italic"
                android:gravity="center"/>

        </LinearLayout>

        <!-- Spacer for Upcoming balance (Dynamic Weight Handling) -->
        <View
            android:id="@+id/upcomingSpacer"
            android:layout_width="86dp"
            android:layout_height="1dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>